      "typeVersion": 1,
      "id": "075f759d-f001-4349-beb0-86a880518e08",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GROQ_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "=json",
        "bodyParameters": {
          "parameters": [
            {}
          ]
        },
        "jsonBody": "=\n{{ JSON.stringify({\n  model: \"openai/gpt-oss-120b\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"You are a recruitment evaluation assistant. Provide objective, evidence-based, job-related analysis for human review only.\"\n    },\n    {\n      role: \"user\",\n      content: $json.aiPrompt\n    }\n  ],\n  temperature: 0.2,\n  response_format: {\n    type: \"json_object\"\n  }\n}) }}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2624,
        336
      ],
      "id": "05d4657e-dee2-4d5c-b83a-2b7e6d8891e9",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $json.choices?.[0]?.message?.content;\n\nif (!response) {\n  throw new Error('Groq returned an empty response');\n}\n\nlet evaluation;\n\ntry {\n  evaluation = JSON.parse(response);\n} catch (error) {\n  throw new Error('Groq response is not valid JSON: ' + error.message);\n}\n\n// Recover original applicant information\nconst source = $('Building AI prompt').item.json;\n\nreturn {\n  json: {\n    ...source,\n    aiScore: evaluation.score,\n    aiClassification: evaluation.classification,\n    aiSummary: evaluation.summary,\n    aiStrengths: evaluation.strengths,\n    aiConcerns: evaluation.concerns,\n    interviewRecommendation: evaluation.interviewRecommendation\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2848,
        336
      ],
      "id": "0704fa63-f6e8-4e51-a460-3c067d07e03b",
      "name": "Parse AI response"
    },
    {
      "parameters": {
        "jsCode": "\nconst d = $json;\nconst app = d.applicationDetails;\n\nconst isBDM = app.role === 'Business Development Manager';\n\nconst toText = (v) => {\n  if (v === undefined || v === null) return '';\n  if (Array.isArray(v)) return v.map(toText).join('; ');\n  if (typeof v === 'object') return Object.values(v).map(toText).join(' - ');\n  return String(v);\n};\n\n\nreturn {\n  json: {\n    'Candidate ID': `CAND-${Date.now()}-${Math.floor(Math.random() * 10000)}`,\n    'Name': app.name,\n    'Email': app.email,\n    'Phone': app.phone,\n    'Role': app.role,\n    'Resume URL': d['Resume/CV'] || d['Resume'] || '',\n    'LinkedIn URL': app.linkedin,\n    'Experience Years': app.experience,\n\n    'Extra Field 1': isBDM\n      ? app.additionalDetails.industryExperience\n      : app.additionalDetails.primaryProgrammingLanguage,\n\n    'Extra field 2': isBDM\n      ? app.additionalDetails.largestDealClosedUSD\n      : app.additionalDetails.github,\n\n    'AI Score': d.aiScore,\n    'AI Classification': d.aiClassification,\n    'AI Summary': toText(d.aiSummary),\n    'AI Strengths': toText(d.aiStrengths),\n    'AI Concerns': toText(d.aiConcerns),\n    'Interview Rec': toText(d.interviewRecommendation),\n\n    'Status': 'Pending Human Review',\n    'Processed At': new Date().toISOString()\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3072,
        336
      ],
