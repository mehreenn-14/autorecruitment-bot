    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.filter(item => {\n  const status = String(item.json.Status || '')\n    .trim()\n    .toLowerCase();\n\n  return status === '' || status === 'new';\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        368
      ],
      "id": "a8f4d12d-a732-486c-a09e-05ba155ac583",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\nconst masterEmails = new Set();\nconst newCandidates = [];\n\nfor (const item of allItems) {\n  // Check if the item comes from the Master Sheet (identified by Candidate ID)\n  if (item.json['Candidate ID'] || item.json.candidateId) {\n    const masterEmail = String(\n      item.json.Email || item.json.email || ''\n    ).trim().toLowerCase();\n    if (masterEmail) {\n      masterEmails.add(masterEmail);\n    }\n  } else {\n    // Otherwise, it's a new incoming application from SWE or BDM forms\n    newCandidates.push(item);\n  }\n}\n\nconst seenThisRun = new Set();\n\nreturn newCandidates.map(item => {\n  const email = String(\n    item.json['Email Address'] || \n    item.json.Email || \n    item.json.email || ''\n  ).trim().toLowerCase();\n\n  const alreadyInMaster = masterEmails.has(email);\n  const alreadyInBatch = seenThisRun.has(email);\n\n  seenThisRun.add(email);\n\n  return {\n    json: {\n      ...item.json,\n      isDuplicate: alreadyInMaster || alreadyInBatch,\n      duplicateReason: alreadyInMaster \n        ? 'exists_in_master' \n        : alreadyInBatch \n          ? 'duplicate_in_batch' \n          : 'none'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1216,
        272
      ],
      "id": "5824c62f-a43b-4574-9da0-2dc30f344380",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "\nconst data = $json;\n\n// Support both form field names\nconst resumeUrl = data['Resume/CV'] || data['Resume'];\n\nif (!resumeUrl) {\n  throw new Error('Resume URL is missing');\n}\n\n// Extract Google Drive file ID\nconst match = resumeUrl.match(/[?&]id=([^&]+)/) ||\n              resumeUrl.match(/\\/file\\/d\\/([^/]+)/);\n\nif (!match) {\n  throw new Error('Could not extract Google Drive file ID');\n}\n\nconst fileId = match[1];\n\nreturn {\n  json: {\n    ...data,\n    resumeFileId: fileId,\n    directDownloadUrl: `https://drive.google.com/uc?export=download&id=${fileId}`\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        336
      ],
      "id": "bfc15d89-5124-4e62-af1a-4a59768e5223",
      "name": "Convert Drive URL to Direct Download"
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        2176,
        336
      ],
      "id": "013d394a-2761-4ab9-9e86-b33e3565be6a",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.resumeFileId }}",
          "mode": "id"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1952,
        336
      ],
      "id": "cc627580-3b97-429f-a5b0-8235224f2a55",
      "name": "Download file"
    },
    {
      "parameters": {
        "jsCode": "\nconst extracted = $json;\n\n// Recover the original application details\nconst source = $('Convert Drive URL to Direct Download').item.json;\n\nconst data = {\n  ...source,\n  ...extracted\n};\n\nconst isBDM =\n  data['Industry Experience'] !== undefined ||\n  data['Largest Deal Closed in USD'] !== undefined;\n\nconst isSWE =\n  data['Primary Programming Language'] !== undefined ||\n  data['Github Profile URL'] !== undefined;\n\nif (!isBDM && !isSWE) {\n  throw new Error('Could not identify applicant role');\n}\n\nconst role = isBDM\n  ? 'Business Development Manager'\n  : 'Software Engineer';\n\nconst cvText = data.text || '';\n\nconst applicationDetails = {\n  name: data.Name || data['Full Name'] || '',\n  email: data.Email || '',\n  phone: data['Phone Number'] || data['Phone number'] || '',\n  role,\n  experience: data.Experience || data['Years of Experience'] || '',\n  linkedin: data['LinkedIn Profile URL'] || '',\n  additionalDetails: isBDM\n    ? {\n        industryExperience: data['Industry Experience'] || '',\n        largestDealClosedUSD: data['Largest Deal Closed in USD'] || ''\n      }\n    : {\n        primaryProgrammingLanguage: data['Primary Programming Language'] || '',\n        github: data['Github Profile URL'] || ''\n      }\n};\n\nconst prompt = `\nYou are assisting a human hiring team.\n\nEvaluate this candidate ONLY for the following role:\n${role}\n\nCandidate information:\n${JSON.stringify(applicationDetails, null, 2)}\n\nExtracted CV:\n${cvText}\n\nProvide:\n1. Job-related skills summary.\n2. Evidence-based strengths.\n3. Missing information or concerns.\n4. Suggested interview focus.\n5. Preliminary score from 1 to 10.\n\nDo not infer protected characteristics.\nDo not make final hiring or rejection decisions.\nA human must review every application.\n\nReturn valid JSON with:\nscore, classification, summary, strengths, concerns,\ninterviewRecommendation.\n\nClassification must be one of:\nStrong Match, Potential Match, Needs Human Review.\n`;\n\nreturn {\n  json: {\n    ...data,\n    applicationDetails,\n    aiPrompt: prompt\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        336
      ],
      "id": "e5b7fb27-6250-4967-9e3e-59389e55388f",
      "name": "Building AI prompt"
    },
    {
      "parameters": {
        "content": "## Reason for using google drive\nhttps was throwing errors due to the link so i used google drive to download directly ",
        "color": "#3B2353"
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        1872,
